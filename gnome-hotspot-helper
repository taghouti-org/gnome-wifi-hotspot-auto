#!/bin/bash
# Root helper for the Wi-Fi Hotspot Auto GNOME extension (run through pkexec).
#   start <parent-iface> <ap-iface> <ssid> <channel|0>   (passphrase on stdin)
#   stop  <parent-iface> <ap-iface>
# Creates a virtual AP interface next to the client connection, runs hostapd +
# dnsmasq (DHCP) on it and NATs the clients out through the host.
set -eu
RUN=/run/gnome-hotspot-ext
SUBNET=10.42.99
action=${1:-}; parent=${2:-}; ap=${3:-}
re='^[a-zA-Z0-9_-]{1,15}$'
[[ $parent =~ $re && $ap =~ $re ]] || { echo "bad interface name" >&2; exit 2; }

nat() {  # nat add|del
  local op=$1; local A=-A I=-I fw=--add-rule
  [[ $op == del ]] && { A=-D; I=-D; fw=--remove-rule; }
  iptables -t nat $A POSTROUTING -s $SUBNET.0/24 ! -o "$ap" -j MASQUERADE 2>/dev/null || true
  iptables $I INPUT -i "$ap" -j ACCEPT 2>/dev/null || true
  iptables $I FORWARD -i "$ap" -j ACCEPT 2>/dev/null || true
  iptables $I FORWARD -o "$ap" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
  # firewalld overrides plain iptables rules: add runtime-only direct rules too.
  if command -v firewall-cmd >/dev/null && firewall-cmd --state &>/dev/null; then
    firewall-cmd -q --direct $fw ipv4 nat POSTROUTING 0 -s $SUBNET.0/24 ! -o "$ap" -j MASQUERADE 2>/dev/null || true
    firewall-cmd -q --direct $fw ipv4 filter INPUT 0 -i "$ap" -j ACCEPT 2>/dev/null || true
    firewall-cmd -q --direct $fw ipv4 filter FORWARD 0 -i "$ap" -j ACCEPT 2>/dev/null || true
    firewall-cmd -q --direct $fw ipv4 filter FORWARD 0 -o "$ap" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
  fi
}

killpid() {
  local f=$1
  [[ -f $f ]] || return 0
  local pid; pid=$(cat "$f" 2>/dev/null || true)
  [[ -n $pid && -d /proc/$pid ]] && kill "$pid" 2>/dev/null || true
  rm -f "$f"
}

stop() {
  killpid $RUN/hostapd.pid
  killpid $RUN/dnsmasq.pid
  nat del
  if ip link show "$ap" &>/dev/null; then
    ip addr flush dev "$ap" 2>/dev/null || true
    ip link set "$ap" down 2>/dev/null || true
    iw dev "$ap" del 2>/dev/null || true
  fi
  rm -f $RUN/hostapd.conf $RUN/hostapd.log
}

case $action in
  start)
    ssid=${4:-}; chan=${5:-0}
    IFS= read -r pass || true
    [[ -n $ssid && ${#ssid} -le 32 && $ssid != *$'\n'* ]] || { echo "invalid SSID" >&2; exit 2; }
    [[ ${#pass} -ge 8 && ${#pass} -le 63 ]] || { echo "passphrase must be 8-63 characters" >&2; exit 2; }
    [[ $chan =~ ^[0-9]{1,3}$ ]] || { echo "bad channel" >&2; exit 2; }
    command -v hostapd >/dev/null || { echo "hostapd is not installed (sudo apt install hostapd)" >&2; exit 3; }
    command -v dnsmasq >/dev/null || { echo "dnsmasq is not installed" >&2; exit 3; }

    mkdir -p $RUN; chmod 755 $RUN
    stop   # clean any previous run

    mac=$(cat "/sys/class/net/$parent/address")
    IFS=: read -r a b c d e f <<<"$mac"
    a=$(printf '%02x' $(( 0x$a | 2 )))
    f=$(printf '%02x' $(( (0x$f + 1) & 255 )))
    iw dev "$parent" interface add "$ap" type __ap addr "$a:$b:$c:$d:$e:$f"
    nmcli device set "$ap" managed no 2>/dev/null || true

    if (( chan == 0 )); then chan=6; fi
    if (( chan > 14 )); then hw=a; else hw=g; fi
    cat > $RUN/hostapd.conf <<CONF
interface=$ap
driver=nl80211
ssid=$ssid
hw_mode=$hw
channel=$chan
ieee80211n=1
wmm_enabled=1
auth_algs=1
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
wpa_passphrase=$pass
CONF
    chmod 600 $RUN/hostapd.conf

    ip addr add $SUBNET.1/24 dev "$ap"
    ip link set "$ap" up
    if ! hostapd -B -P $RUN/hostapd.pid -f $RUN/hostapd.log $RUN/hostapd.conf >$RUN/hostapd.out 2>&1; then
      { tail -n 5 $RUN/hostapd.out; tail -n 5 $RUN/hostapd.log 2>/dev/null; } >&2
      stop; exit 4
    fi
    sleep 1
    chmod 644 $RUN/hostapd.log 2>/dev/null || true   # readable by the extension's log viewer
    if ! [[ -d /proc/$(cat $RUN/hostapd.pid 2>/dev/null || echo x) ]]; then
      tail -n 8 $RUN/hostapd.log >&2 2>/dev/null || true
      stop; exit 4
    fi

    dnsmasq --conf-file=/dev/null --pid-file=$RUN/dnsmasq.pid --interface="$ap" --bind-interfaces \
      --listen-address=$SUBNET.1 --port=0 --dhcp-range=$SUBNET.10,$SUBNET.100,255.255.255.0,12h \
      --dhcp-option=3,$SUBNET.1 --dhcp-option=6,1.1.1.1,8.8.8.8 \
      --dhcp-leasefile=$RUN/dnsmasq.leases || { echo "dnsmasq failed" >&2; stop; exit 5; }
    sysctl -qw net.ipv4.ip_forward=1
    nat add
    ;;
  stop) stop ;;
  *) echo "usage: $0 start|stop <parent> <ap> ..." >&2; exit 2 ;;
esac
